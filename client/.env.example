# URL du backend en production (laisser vide en local : Vite proxy /api vers localhost:5000)
VITE_API_URL=

# Clé publique Kkiapay (widget de paiement Mobile Money). Une clé "publique"
# est faite pour être exposée côté client (comme une clé publiable Stripe) —
# ce n'est pas un secret à protéger. Sandbox = clé de test fournie par Kkiapay ;
# Production = clé réelle du compte marchand, à récupérer sur kkiapay.me.
VITE_KKIAPAY_KEY=c56683b01f7511f087baa9b5af50e7ed

# "true" en développement/démo, "false" uniquement en production réelle
# (avec la vraie clé ci-dessus) pour accepter de vrais paiements.
VITE_KKIAPAY_SANDBOX=true
